/* ============================================================
   Best Wallet — light theme ("Native (white)")
   ------------------------------------------------------------
   Originally GENERATED by contrib/make_light_theme.py from
   brand.qss, but it has since diverged: several blocks here are
   deliberately not a recolour of the dark sheet. This file is
   hand-maintained now -- edit it directly, alongside the matching
   block in brand.qss, and keep the two selector-for-selector
   identical so no widget is left unstyled on either theme.

   Do NOT re-run make_light_theme.py: it would overwrite those
   divergences. (It currently aborts before writing, because the
   blocks it patches no longer match.)

   Palette:
     page background      #FFFFFF
     card / panel         #F7F8FA
     divider / border     #E2E6EB
     primary text         #16191D
     secondary text       #5A6472
     tertiary text        #8B95A3
     accent               #FE681B
     success              #1F9D53
   ============================================================ */

/* ================== Dialogs, message boxes and popups ================== */
/* Everything that opens in its own window: QMessageBox (Utils::showError /
   showInfo / showWarning all route through it), the dialogs under src/dialog,
   Qt's own QInputDialog / QFileDialog / QProgressDialog, and the tooltip.

   None of this was styled before, so it kept the desktop's palette while the
   app's own label colours still reached inside -- which is how a message could
   come up as white text on a white, system-drawn background. The rules below
   give every popup the same surface, text and controls the pages use.

   Deliberately the first block in the file: these are the least specific
   selectors here, so every page- and wizard-scoped rule further down still
   outranks them. */

QDialog,
QMessageBox,
QInputDialog,
QProgressDialog,
QFileDialog,
QColorDialog,
QFontDialog {
    background: #FFFFFF;
    color: #16191D;
}

QDialog QLabel,
QMessageBox QLabel,
QInputDialog QLabel,
QProgressDialog QLabel {
    background: transparent;
    color: #16191D;
    font: 13px 'Inter';
}

QDialog QLabel:disabled,
QMessageBox QLabel:disabled {
    color: #8B95A3;
}

/* Qt gives the message box's informative text its own object name; without
   this it inherits the heading's weight and the two run together. */
QMessageBox QLabel#qt_msgbox_informativelabel {
    color: #5A6472;
}

QDialog QGroupBox {
    background: #F7F8FA;
    border: #F7F8FA_BORDER;
    border-radius: 10px;
    color: #16191D;
    font: 13px 'Inter';
    padding-top: 6px;
}

QDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #5A6472;
    font: 13px 'Inter';
}

/* ---- text entry ---- */

QDialog QLineEdit,
QDialog QPlainTextEdit,
QDialog QTextEdit,
QDialog QTextBrowser,
QDialog QSpinBox,
QDialog QDateEdit,
QInputDialog QLineEdit {
    background: #FFFFFF;
    border: #FFFFFF_BORDER;
    border-radius: 8px;
    padding: 6px 10px;
    color: #16191D;
    font: 13px 'Inter';
    selection-background-color: #FE681B;
    selection-color: #FFFFFF;
}

QDialog QLineEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QTextEdit:focus,
QDialog QSpinBox:focus,
QDialog QDateEdit:focus,
QInputDialog QLineEdit:focus {
    border: 1px solid #FE681B;
}

QDialog QLineEdit:disabled,
QDialog QPlainTextEdit:disabled,
QDialog QTextEdit:disabled,
QDialog QSpinBox:disabled {
    color: #8B95A3;
    border: 1px solid #EDF0F3;
}

/* ---- choosers ---- */

QDialog QComboBox,
QInputDialog QComboBox {
    background: #FFFFFF;
    border: #FFFFFF_BORDER;
    border-radius: 8px;
    padding: 6px 10px;
    color: #16191D;
    font: 13px 'Inter';
}

QDialog QComboBox:hover,
QInputDialog QComboBox:hover {
    border: 1px solid #FE681B;
}

QDialog QComboBox::drop-down,
QInputDialog QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 22px;
}

QDialog QComboBox::down-arrow,
QInputDialog QComboBox::down-arrow {
    image: url(:/assets/images/chevron_down_light.svg);
    width: 12px;
    height: 12px;
}

QDialog QComboBox QAbstractItemView,
QInputDialog QComboBox QAbstractItemView {
    background: #F7F8FA;
    border: #F7F8FA_BORDER;
    color: #16191D;
    selection-background-color: #FFF0E6;
    selection-color: #16191D;
    outline: none;
}

QDialog QCheckBox,
QDialog QRadioButton {
    background: transparent;
    color: #16191D;
    font: 13px 'Inter';
    spacing: 8px;
}

QDialog QCheckBox:disabled,
QDialog QRadioButton:disabled {
    color: #8B95A3;
}

QDialog QCheckBox::indicator,
QDialog QRadioButton::indicator {
    width: 17px;
    height: 17px;
}

QDialog QCheckBox::indicator:unchecked {
    image: url(:/assets/images/checkbox_unchecked_light.svg);
}

QDialog QCheckBox::indicator:checked {
    image: url(:/assets/images/checkbox_checked_light.svg);
}

QDialog QRadioButton::indicator:unchecked {
    image: url(:/assets/images/radio_unchecked_light.svg);
}

QDialog QRadioButton::indicator:checked {
    image: url(:/assets/images/radio_checked_light.svg);
}

/* ---- buttons ---- */

QDialog QPushButton,
QMessageBox QPushButton,
QInputDialog QPushButton,
QProgressDialog QPushButton,
QDialogButtonBox QPushButton {
    background-color: #FFFFFF;
    color: #16191D;
    border: #FFFFFF_BORDER;
    border-radius: 10px;
    padding: 6px 16px;
    min-width: 72px;
    font: 13px 'Inter';
}

QDialog QPushButton:hover,
QMessageBox QPushButton:hover,
QInputDialog QPushButton:hover,
QDialogButtonBox QPushButton:hover {
    border: 1px solid #FE681B;
}

QDialog QPushButton:disabled,
QMessageBox QPushButton:disabled,
QDialogButtonBox QPushButton:disabled {
    color: #8B95A3;
    border: 1px solid #EDF0F3;
}

/* The action the dialog is asking for. */
QDialog QPushButton:default,
QMessageBox QPushButton:default,
QDialogButtonBox QPushButton:default {
    background-color: #FE681B;
    color: #FFFFFF;
    border: 1px solid #FE681B;
    font-weight: 600;
}

QDialog QPushButton:default:hover,
QMessageBox QPushButton:default:hover,
QDialogButtonBox QPushButton:default:hover {
    background-color: #E85A0C;
    border: 1px solid #E85A0C;
}

QDialog QToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #16191D;
    padding: 4px;
}

QDialog QToolButton:hover {
    background: #F0F2F4;
}

/* ---- lists and tables ---- */

QDialog QTreeView,
QDialog QTreeWidget,
QDialog QTableView,
QDialog QListView,
QFileDialog QListView,
QFileDialog QTreeView {
    background: #FFFFFF;
    alternate-background-color: #F0F2F4;
    color: #16191D;
    border: #FFFFFF_BORDER;
    border-radius: 10px;
    font: 13px 'Inter';
    outline: none;
}

QDialog QTreeView::item,
QDialog QTreeWidget::item,
QDialog QTableView::item,
QDialog QListView::item {
    padding: 5px 4px;
    border: none;
}

QDialog QTreeView::item:selected,
QDialog QTreeWidget::item:selected,
QDialog QTableView::item:selected,
QDialog QListView::item:selected,
QFileDialog QListView::item:selected,
QFileDialog QTreeView::item:selected {
    background: #FFF0E6;
    color: #16191D;
}

QDialog QTreeView::item:hover,
QDialog QTreeWidget::item:hover,
QDialog QTableView::item:hover,
QDialog QListView::item:hover {
    background: #F0F2F4;
}

QDialog QHeaderView::section,
QFileDialog QHeaderView::section {
    background: #FFFFFF;
    color: #5A6472;
    border: none;
    border-bottom: 1px solid #E2E6EB;
    padding: 6px;
    font: 12px 'Inter';
}

/* ---- tabs, progress, dividers ---- */

QDialog QTabWidget::pane {
    background: #F7F8FA;
    border: #F7F8FA_BORDER;
    border-radius: 10px;
    top: -1px;
}

QDialog QTabBar::tab {
    background: transparent;
    color: #5A6472;
    border: none;
    padding: 7px 14px;
    font: 13px 'Inter';
}

QDialog QTabBar::tab:selected {
    color: #16191D;
    border-bottom: 2px solid #FE681B;
    font-weight: 600;
}

QDialog QTabBar::tab:hover:!selected {
    color: #16191D;
}

QDialog QProgressBar,
QProgressDialog QProgressBar {
    background: #FFFFFF;
    border: #FFFFFF_BORDER;
    border-radius: 7px;
    height: 12px;
    text-align: center;
    color: #16191D;
    font: 11px 'Inter';
}

QDialog QProgressBar::chunk,
QProgressDialog QProgressBar::chunk {
    background-color: #FE681B;
    border-radius: 6px;
}

/* Separator frames. Named by frameShape so container frames, which carry
   their own rules, are left alone. */
QDialog .QFrame[frameShape="HLine"],
QDialog .QFrame[frameShape="VLine"] {
    background-color: #E2E6EB;
    color: #E2E6EB;
    border: none;
    max-height: 1px;
}

QDialog QSplitter::handle {
    background-color: #E2E6EB;
}

/* ---- scrollbars ---- */

QDialog QScrollBar:vertical,
QMessageBox QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QDialog QScrollBar::handle:vertical,
QMessageBox QScrollBar::handle:vertical {
    background: #D5DBE2;
    border-radius: 5px;
    min-height: 28px;
}

QDialog QScrollBar::handle:vertical:hover,
QMessageBox QScrollBar::handle:vertical:hover {
    background: #D5DBE2_HOVER;
}

QDialog QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QDialog QScrollBar::handle:horizontal {
    background: #D5DBE2;
    border-radius: 5px;
    min-width: 28px;
}

QDialog QScrollBar::add-line,
QDialog QScrollBar::sub-line,
QMessageBox QScrollBar::add-line,
QMessageBox QScrollBar::sub-line {
    height: 0;
    width: 0;
    background: none;
    border: none;
}

QDialog QScrollBar::add-page,
QDialog QScrollBar::sub-page,
QMessageBox QScrollBar::add-page,
QMessageBox QScrollBar::sub-page {
    background: none;
}

/* ---- tooltips ---- */
/* Not a QDialog, but the last unthemed popup in the app: without this it is
   drawn by the platform style and lands as a light chip on the dark skin. */

QToolTip {
    background-color: #F7F8FA;
    color: #16191D;
    border: 1px solid #D5DBE2;
    border-radius: 6px;
    padding: 5px 8px;
    font: 12px 'Inter';
}


/* --------------------------- Portfolio ---------------------------- */

#HomeWidget {
    background: #FFFFFF;
}

#HomeWidget QLabel {
    color: #16191D;
    font: 13px 'Inter';
    background: transparent;
}

#HomeWidget QLabel#label_balanceEyebrow {
    color: #8B95A3;
    font: 11px 'Inter';
    font-weight: 600;
}

#HomeWidget QLabel#accountBalance {
    color: #16191D;
    font: 34px 'Inter';
    font-weight: 700;
}

#HomeWidget QFrame#framePill {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 14px;
    padding: 6px 14px;
}

#HomeWidget QLabel#connectionState {
    color: #5A6472;
    font: 12px 'Inter';
    font-weight: 600;
}

/* Status dot. A QLabel rather than a bare QWidget: a plain QWidget does not
   paint a stylesheet background unless WA_StyledBackground is set, which is
   why this indicator rendered invisibly. */
#HomeWidget QLabel#connectionIndicator {
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
    border-radius: 5px;
    background-color: #8B95A3;
}

#HomeWidget QLabel#connectionIndicator[state="disconnected"] {
    background-color: #D64545;
}

#HomeWidget QLabel#connectionIndicator[state="connecting"] {
    background-color: #B8860B;
}

#HomeWidget QLabel#connectionIndicator[state="synchronizing"] {
    background-color: #1E7FD4;
}

#HomeWidget QLabel#connectionIndicator[state="connected"] {
    background-color: #1F9D53;
}

#HomeWidget QLabel#connectionIndicator[state="error"] {
    background-color: #D33A2E;
}

#HomeWidget QFrame#framePill[state="connected"] {
    border: 1px solid #C8E6CF;
}

#HomeWidget QFrame#framePill[state="error"],
#HomeWidget QFrame#framePill[state="disconnected"] {
    border: 1px solid #F3D2CE;
}

#HomeWidget QFrame#frame_chart,
#HomeWidget QFrame#frame_activity {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-top: 1px solid #FFFFFF;
    border-radius: 16px;
    padding: 20px;
}

#HomeWidget QLabel#label_chartTitle,
#HomeWidget QLabel#recentActivity {
    color: #16191D;
    font: 15px 'Inter';
    font-weight: 600;
}

#HomeWidget QLabel#label_chartSubtitle {
    color: #8B95A3;
    font: 11px 'Inter';
}

/* Inset plot surface, so the chart reads as a deliberate component rather
   than a drawing floating on the card. */
#HomeWidget QWidget#chartContainer {
    background: #F7F8FA;
    border: 1px solid #ECEFF2;
    border-radius: 12px;
}

#HomeWidget QWidget#chartEmptyBox {
    background: transparent;
}

#HomeWidget QLabel#chartEmptyTitle {
    color: #5A6472;
    font: 14px 'Inter';
    font-weight: 600;
    background: transparent;
}

#HomeWidget QLabel#chartEmptySubtitle {
    color: #98A1AD;
    font: 12px 'Inter';
    background: transparent;
}

#HomeWidget QLabel#viewHistory {
    color: #5A6472;
    font: 12px 'Inter';
}

#HomeWidget QLabel#viewHistory:hover {
    color: #FE681B;
}

#HomeWidget QFrame#activityRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid #ECEFF2;
    padding: 8px 0;
}

#HomeWidget QLabel#activityLabel {
    color: #16191D;
    font: 13px 'Inter';
}

#HomeWidget QLabel#activityTime {
    color: #8B95A3;
    font: 12px 'Inter';
}

#HomeWidget QLabel#activityEmptyLabel {
    color: #8B95A3;
    font: 13px 'Inter';
    padding: 10px 0;
}

#HomeWidget QLabel#activityBadgeIn {
    background: rgba(31, 157, 83, 0.14);
    color: #1F9D53;
    border-radius: 14px;
    font-weight: 700;
}

#HomeWidget QLabel#activityBadgeOut {
    background: rgba(254, 104, 27, 0.14);
    color: #FE681B;
    border-radius: 14px;
    font-weight: 700;
}

/* ---------------------------- History ---------------------------- */

#HistoryWidget {
    background: #FFFFFF;
}

#HistoryWidget QLabel {
    color: #5A6472;
    font: 13px 'Inter';
    background: transparent;
}

#HistoryWidget QFrame#frame_search {
    background: transparent;
    border: none;
}

#HistoryWidget QLineEdit#search {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    padding: 6px 10px;
    color: #16191D;
    font: 13px 'Inter';
}

#HistoryWidget QLineEdit#search:focus {
    border: 1px solid #FE681B;
}

#HistoryWidget QToolButton#btn_options {
    background: transparent;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    padding: 4px;
}

#HistoryWidget QToolButton#btn_options:hover {
    border: 1px solid #FE681B;
}

#HistoryWidget QFrame#syncNotice {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
}

#HistoryWidget QPushButton#btn_moreInfo,
#HistoryWidget QPushButton#btn_close {
    background-color: #FFFFFF;
    color: #16191D;
    border: 1px solid #D5DBE2;
    border-radius: 10px;
    padding: 4px 14px;
    font: 12px 'Inter';
}

#HistoryWidget QPushButton#btn_moreInfo:hover,
#HistoryWidget QPushButton#btn_close:hover {
    border: 1px solid #FE681B;
}

#HistoryWidget HistoryView {
    background: #FFFFFF;
    alternate-background-color: #F0F2F4;
    color: #16191D;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
    font: 13px 'Inter';
    outline: none;
}

#HistoryWidget HistoryView::item {
    padding: 6px 4px;
    border: none;
}

#HistoryWidget HistoryView::item:selected {
    background: #F7F8FA;
    color: #16191D;
}

#HistoryWidget HistoryView::item:hover {
    background: #F0F2F4;
}

#HistoryWidget QHeaderView::section {
    background: #FFFFFF;
    color: #5A6472;
    border: none;
    border-bottom: 1px solid #E2E6EB;
    padding: 6px;
    font: 12px 'Inter';
}

/* ---------------------------- Settings ---------------------------- */

#Settings {
    background: #FFFFFF;
}

#Settings QStackedWidget,
#Settings QStackedWidget > QWidget {
    background: #FFFFFF;
}

#Settings QLabel {
    color: #16191D;
    font: 13px 'Inter';
    background: transparent;
}

#Settings QListWidget#selector {
    background: #FFFFFF;
    border: none;
    border-right: 1px solid #E2E6EB;
    outline: none;
    padding: 10px 0;
    font: 13px 'Inter';
    color: #5A6472;
}

#Settings QListWidget#selector::item {
    padding: 12px 18px 12px 15px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 8px;
    margin: 2px 8px;
}

#Settings QListWidget#selector::item:selected {
    background: #F7F8FA;
    border-left: 3px solid #FE681B;
    color: #16191D;
    font-weight: 600;
}

#Settings QListWidget#selector::item:hover:!selected {
    background: #F0F2F4;
    color: #16191D;
}

#Settings QTabWidget::pane {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
    top: -1px;
}

#Settings QTabBar::tab {
    background: transparent;
    color: #5A6472;
    padding: 7px 16px;
    font: 13px 'Inter';
    border: none;
    border-bottom: 2px solid transparent;
}

#Settings QTabBar::tab:selected {
    color: #16191D;
    border-bottom: 2px solid #FE681B;
}

#Settings QTabBar::tab:hover:!selected {
    color: #16191D;
}

#Settings QGroupBox {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 12px;
    color: #16191D;
    font: 13px 'Inter';
}

#Settings QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #5A6472;
}

#Settings InfoFrame {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
}

#Settings InfoFrame QLabel {
    background: transparent;
    color: #16191D;
}

#Settings .QFrame[frameShape="StyledPanel"] {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
}

#Settings QDialogButtonBox QPushButton {
    background-color: #FFFFFF;
    color: #16191D;
    border: 1px solid #D5DBE2;
    border-radius: 10px;
    padding: 6px 16px;
    font: 13px 'Inter';
    min-width: 70px;
}

#Settings QDialogButtonBox QPushButton:hover {
    border: 1px solid #FE681B;
}

/* -------------------------- Wallet wizards -------------------------- */
/* WalletWizard and OfflineTxSigningWizard are the only QWizard
   subclasses in this app, so this scope is exclusive to them. */

QWizard {
    background: #FFFFFF;
}

QWizard QWizardPage {
    background: #FFFFFF;
}

QWizard QLabel {
    background: transparent;
    color: #16191D;
    font: 13px 'Inter';
}

QWizard QGroupBox {
    background: #F7F8FA;
    border: none;
    border-radius: 10px;
    color: #16191D;
    font: 13px 'Inter';
}

QWizard QGroupBox::title {
    color: #16191D;
    font: 14px 'Inter';
}

QWizard InfoFrame {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
}

QWizard InfoFrame QLabel {
    background: transparent;
}

QWizard .QFrame[frameShape="StyledPanel"] {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
}

QWizard Line {
    background-color: #E2E6EB;
    color: #E2E6EB;
    max-height: 1px;
    border: none;
}

/* ---------------------- shared form controls ---------------------- */
/* Applies within History / Settings / the wizards only. */

#HistoryWidget QLineEdit,
#Settings QLineEdit,
QWizard QLineEdit {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    padding: 6px 8px;
    color: #16191D;
    font: 13px 'Inter';
    selection-background-color: #FE681B;
    selection-color: #FFFFFF;
}

#HistoryWidget QLineEdit:focus,
#Settings QLineEdit:focus,
QWizard QLineEdit:focus {
    border: 1px solid #FE681B;
}

#HistoryWidget QLineEdit:disabled,
#Settings QLineEdit:disabled,
QWizard QLineEdit:disabled {
    color: #8B95A3;
    border: 1px solid #EDF0F3;
}

#Settings QComboBox,
QWizard QComboBox {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    padding: 5px 8px;
    color: #16191D;
    font: 13px 'Inter';
    min-height: 20px;
}

#Settings QComboBox:hover,
QWizard QComboBox:hover {
    border: 1px solid #FE681B;
}

#Settings QComboBox::drop-down,
QWizard QComboBox::drop-down {
    border: none;
    width: 22px;
}

#Settings QComboBox QAbstractItemView,
QWizard QComboBox QAbstractItemView {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    color: #16191D;
    selection-background-color: #FFF0E6;
    selection-color: #16191D;
    outline: none;
}

#Settings QSpinBox,
QWizard QSpinBox {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    padding: 4px 6px;
    color: #16191D;
    font: 13px 'Inter';
}

#Settings QCheckBox,
QWizard QCheckBox {
    background: transparent;
    color: #16191D;
    font: 13px 'Inter';
    spacing: 8px;
}

#Settings QCheckBox::indicator,
QWizard QCheckBox::indicator {
    width: 17px;
    height: 17px;
}

#Settings QCheckBox::indicator:unchecked,
QWizard QCheckBox::indicator:unchecked {
    image: url(:/assets/images/checkbox_unchecked_light.svg);
}

#Settings QCheckBox::indicator:checked,
QWizard QCheckBox::indicator:checked {
    image: url(:/assets/images/checkbox_checked_light.svg);
}

#Settings QCheckBox:disabled,
QWizard QCheckBox:disabled {
    color: #8B95A3;
}

#Settings QRadioButton,
QWizard QRadioButton {
    background: transparent;
    color: #16191D;
    font: 13px 'Inter';
    spacing: 8px;
}

#Settings QRadioButton::indicator,
QWizard QRadioButton::indicator {
    width: 17px;
    height: 17px;
}

#Settings QRadioButton::indicator:unchecked,
QWizard QRadioButton::indicator:unchecked {
    image: url(:/assets/images/radio_unchecked_light.svg);
}

#Settings QRadioButton::indicator:checked,
QWizard QRadioButton::indicator:checked {
    image: url(:/assets/images/radio_checked_light.svg);
}

/* The chosen option names itself in the accent, matching its filled dot. */
QWizard QRadioButton:checked {
    color: #FE681B;
}

#Settings QPushButton,
QWizard QPushButton {
    background-color: #FFFFFF;
    color: #16191D;
    border: 1px solid #D5DBE2;
    border-radius: 10px;
    padding: 6px 16px;
    font: 13px 'Inter';
}

#Settings QPushButton:hover,
QWizard QPushButton:hover {
    border: 1px solid #FE681B;
}

#Settings QPushButton:disabled,
QWizard QPushButton:disabled {
    color: #8B95A3;
    border: 1px solid #E2E6EB;
}

#Settings QPushButton:flat,
QWizard QPushButton:flat {
    background: transparent;
    border: none;
    color: #5A6472;
}

/* The step the wizard wants you to take. Named in WalletWizard's constructor,
   since QWizard's own buttons carry no stable object name. */
QWizard QPushButton#wizardPrimary {
    background-color: #FE681B;
    border: 1px solid #FE681B;
    color: #FFFFFF;
    font-weight: 600;
}

QWizard QPushButton#wizardPrimary:hover {
    background-color: #E85A0C;
    border: 1px solid #E85A0C;
}

QWizard QPushButton#wizardPrimary:pressed {
    background-color: #C94E0A;
    border: 1px solid #C94E0A;
}

QWizard QPushButton#wizardPrimary:disabled {
    background-color: #FAD5BE;
    border: 1px solid #FAD5BE;
    color: #B58463;
}

#Settings QPushButton:flat:hover,
QWizard QPushButton:flat:hover {
    color: #FE681B;
}

#Settings QTreeView,
#Settings QTreeWidget,
#Settings QTableView,
QWizard QTreeView,
QWizard QTableView {
    background: #FFFFFF;
    alternate-background-color: #F0F2F4;
    color: #16191D;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
    font: 13px 'Inter';
    outline: none;
}

#Settings QTreeView::item,
#Settings QTreeWidget::item,
#Settings QTableView::item,
QWizard QTreeView::item,
QWizard QTableView::item {
    padding: 6px 4px;
    border: none;
    color: #16191D;
}

#Settings QTreeView::item:selected,
#Settings QTreeWidget::item:selected,
#Settings QTableView::item:selected,
QWizard QTreeView::item:selected,
QWizard QTableView::item:selected {
    background: #F7F8FA;
    color: #16191D;
}

#Settings QTreeView::item:hover,
#Settings QTreeWidget::item:hover,
#Settings QTableView::item:hover,
QWizard QTreeView::item:hover,
QWizard QTableView::item:hover {
    background: #F0F2F4;
}

#Settings QHeaderView::section,
QWizard QHeaderView::section {
    background: #FFFFFF;
    color: #5A6472;
    border: none;
    border-bottom: 1px solid #E2E6EB;
    padding: 6px;
    font: 12px 'Inter';
}

/* ----------------------------- Send ----------------------------- */

/* Pages paint their own surface: MainWindow no longer supplies a blanket
   background for every descendant. */
#SendWidget,
#ReceiveWidget {
    background: #FFFFFF;
}

#SendWidget QFrame#card_payTo,
#SendWidget QFrame#card_details {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-top: 1px solid #FFFFFF;
    border-radius: 14px;
    padding: 18px;
}

#SendWidget QFrame#card_amount {
    background: #F7F8FA;
    border: 1px solid #FFD9C2;
    border-top: 1px solid #FFC9A8;
    border-radius: 16px;
    padding: 20px;
}

#SendWidget QLabel {
    color: #5A6472;
    font: 13px 'Inter';
    background: transparent;
}

#SendWidget HelpLabel {
    color: #16191D;
    font: 14px 'Inter';
    font-weight: 600;
}

#SendWidget QLabel#label_feeTarget {
    color: #8B95A3;
    font: 12px 'Inter';
}

#SendWidget QLabel#label_conversionAmount {
    color: #8B95A3;
    font: 13px 'Inter';
}

/* Fields are addressed by objectName rather than by custom-class type so the
   rules hold regardless of the concrete widget subclass. */
#SendWidget QLineEdit,
#SendWidget QComboBox,
#SendWidget QPlainTextEdit {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
    padding: 10px 12px;
    color: #16191D;
    font: 13px 'Inter';
    selection-background-color: #FE681B;
    selection-color: #FFFFFF;
}

#SendWidget QLineEdit:focus,
#SendWidget QComboBox:focus,
#SendWidget QPlainTextEdit:focus {
    border: 1px solid #FE681B;
}

/* Address field: roomy and wrapping, monospace so a full address stays
   legible. 12px keeps a 95-character address inside the field's height even
   at narrow window widths. */
#SendWidget QPlainTextEdit#lineAddress {
    padding: 12px 14px;
    font: 12px 'JetBrains Mono', monospace;
    color: #16191D;
}

#SendWidget QLineEdit#lineDescription {
    min-height: 22px;
}

/* The amount is the field you type in, so it gets the recessed well -- the
   same surface the address field and the Scan button sit on. */
#SendWidget QLineEdit#lineAmount {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 12px;
    color: #16191D;
    font: 32px 'Inter';
    font-weight: 700;
    padding: 4px 14px;
}

#SendWidget QLineEdit#lineAmount:focus {
    border: 1px solid #FE681B;
}

/* The unit beside it is a chooser, not a field: no well of its own, just the
   symbol and a chevron saying it opens. */
#SendWidget QComboBox#comboCurrencySelection {
    background: transparent;
    border: none;
    border-radius: 0;
    color: #16191D;
    font: 15px 'Inter';
    font-weight: 700;
    padding: 4px 2px;
    min-width: 76px;
}

#SendWidget QComboBox#comboCurrencySelection:focus,
#SendWidget QComboBox#comboCurrencySelection:on {
    background: transparent;
    border: none;
}

#SendWidget QComboBox#comboCurrencySelection:hover {
    color: #FE681B;
}

#SendWidget QComboBox#combo_feePriority {
    background: #FFFFFF;
    padding: 7px 12px;
}

#SendWidget QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 22px;
}

/* Without an explicit image Qt falls back to the palette's arrow, which is
   near-invisible on these surfaces -- the currency chooser read as plain text. */
#SendWidget QComboBox::down-arrow {
    image: url(:/assets/images/chevron_down_light.svg);
    width: 12px;
    height: 12px;
}

#SendWidget QComboBox QAbstractItemView {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    color: #16191D;
    selection-background-color: #FFF0E6;
    selection-color: #16191D;
    outline: none;
}

#SendWidget QCheckBox {
    color: #5A6472;
    font: 12px 'Inter';
    background: transparent;
    spacing: 8px;
}

#SendWidget QCheckBox::indicator {
    width: 17px;
    height: 17px;
}

#SendWidget QCheckBox::indicator:unchecked {
    image: url(:/assets/images/checkbox_unchecked_light.svg);
}

#SendWidget QCheckBox::indicator:checked {
    image: url(:/assets/images/checkbox_checked_light.svg);
}

#SendWidget QPushButton {
    background-color: #FFFFFF;
    color: #16191D;
    border: 1px solid #D5DBE2;
    border-radius: 10px;
    padding: 6px 16px;
    font: 13px 'Inter';
}

#SendWidget QPushButton:hover {
    border: 1px solid #FE681B;
}

#SendWidget QPushButton:disabled {
    color: #8B95A3;
    border: 1px solid #E2E6EB;
}

#SendWidget QPushButton#btnMax {
    background: transparent;
    border: 1px solid #FE681B;
    color: #FE681B;
    border-radius: 14px;
    padding: 4px 14px;
    font: 12px 'Inter';
    font-weight: 600;
}

#SendWidget QPushButton#btnMax:hover {
    background: rgba(254, 104, 27, 0.10);
}

#SendWidget QPushButton#btnScan {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
    color: #5A6472;
    font: 12px 'Inter';
    font-weight: 600;
    /* Sits beside the address field at matching height; the icon carries the
       meaning, the label confirms it. */
    padding: 0 10px;
    text-align: center;
}

#SendWidget QPushButton#btnScan:hover {
    background: #FFF4EE;
    border: 1px solid #FE681B;
    color: #FE681B;
}

#SendWidget QPushButton#btnScan:pressed {
    background: #F0F2F4;
    border: 1px solid #FE681B;
}

#SendWidget QPushButton#btnScan:disabled {
    background: #F4F6F8;
    border: 1px solid #ECEFF2;
    color: #A9B0B9;
}

#SendWidget QPushButton#btn_openAlias,
#SendWidget QPushButton#btnClear {
    background: transparent;
    border: 1px solid #E2E6EB;
    color: #5A6472;
    min-height: 34px;
    font: 12px 'Inter';
}

#SendWidget QPushButton#btn_openAlias:hover,
#SendWidget QPushButton#btnClear:hover {
    color: #16191D;
    border: 1px solid #D5DBE2;
}

#SendWidget QPushButton#btnSend {
    background-color: #FE681B;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-weight: 600;
    font-size: 15px;
    min-height: 50px;
    padding: 0 28px;
}

#SendWidget QPushButton#btnSend:hover {
    background-color: #E85A0C;
}

#SendWidget QPushButton#btnSend:pressed {
    background-color: #C94E0A;
}

#SendWidget QPushButton#btnSend:disabled {
    background-color: #FAD5BE;
    color: #B58463;
}

/* ---------------------------- Receive ---------------------------- */

#ReceiveWidget QFrame#card_qr {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-top: 1px solid #FFFFFF;
    border-radius: 18px;
    padding: 24px;
}

#ReceiveWidget QFrame#card_addresses {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-top: 1px solid #FFFFFF;
    border-radius: 16px;
    padding: 18px;
}

#ReceiveWidget QLabel {
    color: #5A6472;
    font: 13px 'Inter';
    background: transparent;
}

#ReceiveWidget QLabel#label_allAddresses {
    color: #16191D;
    font: 15px 'Inter';
    font-weight: 600;
}

#ReceiveWidget QLabel#label_currentAddress {
    color: #5A6472;
    font: 12px 'JetBrains Mono', monospace;
    padding: 0 8px;
}

#ReceiveWidget QToolButton#btn_copyAddress {
    background: #ECEFF2;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    color: #16191D;
    padding: 4px 12px;
    font: 12px 'Inter';
    font-weight: 600;
}

#ReceiveWidget QToolButton#btn_copyAddress:hover {
    border: 1px solid #FE681B;
    color: #FE681B;
}

#ReceiveWidget QLineEdit#search {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    padding: 6px 10px;
    color: #16191D;
    font: 13px 'Inter';
}

#ReceiveWidget QLineEdit#search:focus {
    border: 1px solid #FE681B;
}

#ReceiveWidget QToolButton#toolBtn_options {
    background: transparent;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    padding: 4px;
}

#ReceiveWidget QToolButton#toolBtn_options:hover {
    border: 1px solid #FE681B;
}

#ReceiveWidget SubaddressView {
    background: #FFFFFF;
    alternate-background-color: #F0F2F4;
    color: #16191D;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
    font: 13px 'Inter';
    outline: none;
}

#ReceiveWidget SubaddressView::item {
    padding: 6px 4px;
    border: none;
}

#ReceiveWidget SubaddressView::item:selected {
    background: #F7F8FA;
    color: #16191D;
}

#ReceiveWidget SubaddressView::item:hover {
    background: #F0F2F4;
}

#ReceiveWidget QHeaderView::section {
    background: #FFFFFF;
    color: #5A6472;
    border: none;
    border-bottom: 1px solid #E2E6EB;
    padding: 6px;
    font: 12px 'Inter';
}

/* The white plate behind the code is painted with the pixmap now, rounded to
   this radius (see Utils::qrCodePlate). Painting it here as well put a
   hard-edged square under a rounded one, which is what poked out at the
   corners; the label itself stays clear. */
#ReceiveWidget ClickableLabel#qrCode {
    background: transparent;
    border-radius: 16px;
}

#ReceiveWidget QPushButton {
    background-color: #FFFFFF;
    color: #16191D;
    border: 1px solid #D5DBE2;
    border-radius: 10px;
    padding: 6px 16px;
    font: 13px 'Inter';
}

#ReceiveWidget QPushButton:hover {
    border: 1px solid #FE681B;
}

#ReceiveWidget QPushButton#btn_generateSubaddress {
    background-color: #FE681B;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-weight: 600;
    min-height: 40px;
}

#ReceiveWidget QPushButton#btn_generateSubaddress:hover {
    background-color: #E85A0C;
}

/* -------------------------- scroll bars -------------------------- */

#HistoryWidget QScrollBar:vertical,
#Settings QScrollBar:vertical,
#SendWidget QScrollBar:vertical,
#ReceiveWidget QScrollBar:vertical,
QWizard QScrollBar:vertical {
    background: #FFFFFF;
    width: 10px;
    margin: 0;
}

#HistoryWidget QScrollBar::handle:vertical,
#Settings QScrollBar::handle:vertical,
#SendWidget QScrollBar::handle:vertical,
#ReceiveWidget QScrollBar::handle:vertical,
QWizard QScrollBar::handle:vertical {
    background: #E2E6EB;
    border-radius: 5px;
    min-height: 24px;
}

#HistoryWidget QScrollBar::handle:vertical:hover,
#Settings QScrollBar::handle:vertical:hover,
#SendWidget QScrollBar::handle:vertical:hover,
#ReceiveWidget QScrollBar::handle:vertical:hover,
QWizard QScrollBar::handle:vertical:hover {
    background: #D5DBE2;
}

#HistoryWidget QScrollBar::add-line:vertical,
#HistoryWidget QScrollBar::sub-line:vertical,
#Settings QScrollBar::add-line:vertical,
#Settings QScrollBar::sub-line:vertical,
#SendWidget QScrollBar::add-line:vertical,
#SendWidget QScrollBar::sub-line:vertical,
#ReceiveWidget QScrollBar::add-line:vertical,
#ReceiveWidget QScrollBar::sub-line:vertical,
QWizard QScrollBar::add-line:vertical,
QWizard QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

/* ===================== Window chrome ===================== */
/* Lives here rather than in MainWindow.ui: an inline stylesheet on the window
   is an ancestor stylesheet and outranks the application stylesheet whatever
   the specificity, which would make it impossible for a theme to restyle the
   chrome. */
QMainWindow,
#centralWidget {
	background-color: #F4F6F8;
}

QGroupBox#tickerPct {
	font: 14px;
	font-family: 'Inter';
}

QGroupBox#tickerBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 10px;

    margin-top: 17px;
}

QGroupBox#tickerBox::title {
    color: #16191D;
    font-family: 'Inter';
    font-size: 16px;

    subcontrol-origin: margin;
    subcontrol-position: top left;

    top: -4px;
    padding: 0 5px;
    background-color: transparent;
}

QStatusBar {
	background-color: #F7F8FA;
	border-top: 1px solid #E2E6EB;
	color: #6B7480;
}

/* Qt draws frames around status bar items on some platforms. */
QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #6B7480;
    background-color: transparent;
    font: 12px 'Inter';
}

QStatusBar QLabel#statusText {
    color: #2B313A;
    font: 12px 'Inter';
}

QStatusBar QLabel#statusNetStats {
    color: #8B95A3;
}

/* The wallet's headline figure: a quiet pill that lifts on hover, since it
   opens the balance breakdown. */
QStatusBar QLabel#statusBalance {
    background-color: #FFFFFF;
    border: 1px solid #E8ECF1;
    border-radius: 9px;
    padding: 4px 12px;
    font: 12px 'Inter';
}

QStatusBar QLabel#statusBalance:hover {
    border: 1px solid #FE681B;
}

QStatusBar QFrame#statusSeparator {
    background-color: #E8ECF1;
    border: none;
    margin: 0 4px;
}

QStatusBar QPushButton#statusBarButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QStatusBar QPushButton#statusBarButton:hover {
    background-color: #EDF0F3;
}

QStatusBar QPushButton#statusBarButton:pressed {
    background-color: #E2E6EB;
}

QMenuBar {
    background-color: #F4F6F8;
    color: #16191D;
}

QMenuBar::item {
    padding: 3px 8px;
    background-color: transparent;
    color: #16191D;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #E8ECF1;
    color: #16191D;
}

QMenu {
    background-color: #FFFFFF;
    color: #16191D;
    border: 1px solid #E2E6EB;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    color: #16191D;
    padding: 6px 22px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #E8ECF1;
    color: #16191D;
}

QMenu::separator {
    height: 1px;
    background-color: #E2E6EB;
    margin: 5px 8px;
}

/* The maintenance notice, shown in place of the whole swap page when the
   exchange refuses this build's credential. Sized and centred by the layout;
   only the surface and type are set here. */
#SwapWidget QFrame#card_unavailable {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-radius: 16px;
    padding: 28px 32px;
}

#SwapWidget QLabel#label_unavailableTitle {
    color: #16191D;
    font: 17px 'Inter';
    font-weight: 600;
}

/* The recommended action carries the accent; "Try again" stays a plain
   button, because retrying rarely helps when a credential has been refused. */
#SwapWidget QPushButton#btn_getLatest {
    background-color: #FE681B;
    border: 1px solid #FE681B;
    color: #FFFFFF;
    min-height: 32px;
    font-weight: 600;
}

#SwapWidget QPushButton#btn_getLatest:hover {
    background-color: #ff7a34;
    border: 1px solid #ff7a34;
}

#SwapWidget QLabel#label_unavailableBody {
    color: #5A6472;
    font: 13px 'Inter';
}

/* ---------------------------- Swap ---------------------------- */
/* Follows the Send page deliberately: same surfaces, same field metrics, the
   accent reserved for the one button that commits. The page is two faces in a
   stack -- the quote form and the order panel -- and both are styled here. */

#SwapWidget {
    background: #FFFFFF;
}

#SwapWidget QFrame#card_amount {
    background: #F7F8FA;
    border: 1px solid #FFD9C2;
    border-top: 1px solid #FFC9A8;
    border-radius: 16px;
    padding: 18px;
}

#SwapWidget QFrame#card_payTo,
#SwapWidget QFrame#card_deposit,
#SwapWidget QFrame#card_orderDetails {
    background: #F7F8FA;
    border: 1px solid #E2E6EB;
    border-top: 1px solid #FFFFFF;
    border-radius: 14px;
    padding: 18px;
}

#SwapWidget QLabel {
    color: #5A6472;
    font: 13px 'Inter';
    background: transparent;
}

/* Fields are addressed by objectName rather than by widget class so the rules
   hold regardless of the concrete subclass, as on the Send page. */
#SwapWidget QLineEdit,
#SwapWidget QComboBox {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
    padding: 10px 12px;
    color: #16191D;
    font: 13px 'Inter';
    selection-background-color: #FE681B;
    selection-color: #FFFFFF;
}

#SwapWidget QLineEdit:focus,
#SwapWidget QComboBox:focus {
    border: 1px solid #FE681B;
}

/* Addresses are compared character by character, so they get a monospace face
   the way the Send page's address field does. */
#SwapWidget QLineEdit#lineDestination,
#SwapWidget QLineEdit#lineRefund,
#SwapWidget QLineEdit#lineMemo {
    font: 12px 'JetBrains Mono', monospace;
}

/* The two amounts are the headline of the page, so they take the Send page's
   amount metrics rather than the ordinary field ones. */
#SwapWidget QLineEdit#lineAmountFrom,
#SwapWidget QLineEdit#lineAmountTo {
    border-radius: 12px;
    font: 26px 'Inter';
    font-weight: 700;
    padding: 4px 14px;
}

/* An amount the exchange will not accept, said directly under the field that
   holds it. */
#SwapWidget QLabel#label_amountNotice {
    font: 12px 'Inter';
    font-weight: 600;
}

/* Stating the limit is not the same as reporting a breach of it. */
#SwapWidget QLabel#label_amountNotice[state="info"] {
    color: #8B95A3;
    font-weight: 400;
}

#SwapWidget QLabel#label_amountNotice[state="invalid"] {
    color: #C0392B;
}

/* The field carries the rejection too, so the eye lands on the input rather
   than only on the sentence below it. */
#SwapWidget QLineEdit#lineAmountFrom[state="invalid"] {
    background: rgba(192, 57, 43, 0.06);
    border: 1px solid #C0392B;
}

/* Typed into as well as filled in, so it takes the ordinary focus state;
   the accent marks it as the side the exchange pays out. */
#SwapWidget QLineEdit#lineAmountTo {
    color: #FE681B;
}


#SwapWidget QComboBox#comboFrom,
#SwapWidget QComboBox#comboTo {
    font: 15px 'Inter';
    font-weight: 700;
    /* Holds the longest entry, "USDT (Solana)", plus its mark and chevron. Both
       sides share it so the two amount rows end on the same edge. */
    min-width: 150px;
}

#SwapWidget QComboBox:disabled {
    background: transparent;
    border: none;
    color: #16191D;
}

/* No chevron either: the arrow is the part that promises a list. */
#SwapWidget QComboBox:disabled::drop-down {
    width: 0;
    image: none;
}

#SwapWidget QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 22px;
}

/* Without an explicit image Qt falls back to the palette's arrow, which is
   near-invisible on these surfaces. */
#SwapWidget QComboBox::down-arrow {
    image: url(:/assets/images/chevron_down.svg);
    width: 12px;
    height: 12px;
}

#SwapWidget QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    color: #16191D;
    selection-background-color: #F2F4F7;
    selection-color: #16191D;
    outline: none;
}

#SwapWidget QPushButton {
    background-color: #FFFFFF;
    color: #16191D;
    border: 1px solid #D5DBE2;
    border-radius: 10px;
    padding: 6px 16px;
    font: 13px 'Inter';
}

#SwapWidget QPushButton:hover {
    background-color: #F2F4F7;
}

#SwapWidget QPushButton:disabled {
    color: #A9B2BD;
    border: 1px solid #E2E6EB;
}

/* Same tinted pill the Send page uses, so "Max" means the same thing on both. */
#SwapWidget QPushButton#btnMax {
    background: transparent;
    border: 1px solid #FE681B;
    color: #FE681B;
    border-radius: 14px;
    padding: 4px 14px;
    font: 12px 'Inter';
    font-weight: 600;
}

#SwapWidget QPushButton#btnMax:hover {
    background: rgba(254, 104, 27, 0.10);
}

/* Sits between the two amounts as a hinge rather than a control with a label,
   so it is a disc carrying only the glyph. */
#SwapWidget QPushButton#btn_reverse {
    background: rgba(254, 104, 27, 0.10);
    border: 1px solid #FFD9C2;
    color: #FE681B;
    border-radius: 16px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    font: 15px 'Inter';
    font-weight: 700;
}

#SwapWidget QPushButton#btn_reverse:hover {
    background: rgba(254, 104, 27, 0.20);
}

/* The two buttons that move money: the accent is spent on these alone. */
#SwapWidget QPushButton#btn_createSwap,
#SwapWidget QPushButton#btn_sendFromWallet {
    background-color: #FE681B;
    border: 1px solid #FE681B;
    color: #FFFFFF;
    min-height: 34px;
    font: 12px 'Inter';
    font-weight: 600;
}

#SwapWidget QPushButton#btn_createSwap:hover,
#SwapWidget QPushButton#btn_sendFromWallet:hover {
    background-color: #ff7a34;
}

#SwapWidget QPushButton#btn_createSwap:pressed,
#SwapWidget QPushButton#btn_sendFromWallet:pressed {
    background-color: #e05a12;
}

#SwapWidget QPushButton#btn_createSwap:disabled {
    background-color: #FFD0B4;
    border: 1px solid #FFD0B4;
    color: #FFFFFF;
}

/* Balance doubles as a shortcut to Max, so it is coloured as something you
   can press rather than as another caption. */
#SwapWidget QLabel#label_balance {
    color: #FE681B;
    font: 12px 'Inter';
    font-weight: 600;
}

#SwapWidget QLabel#label_fromUsd,
#SwapWidget QLabel#label_toUsd,
#SwapWidget QLabel#label_rate,
#SwapWidget QLabel#label_limits,
#SwapWidget QLabel#label_orderReceive,
#SwapWidget QLabel#label_orderExpiry {
    color: #8B95A3;
    font: 12px 'Inter';
}

/* The exchange's terms are a caveat, not body copy: present, readable, and
   clearly subordinate to the form above it. */
#SwapWidget QLabel#label_disclaimer {
    color: #99A2AE;
    font: 11px 'Inter';
}

#SwapWidget QLabel#label_error,
#SwapWidget QLabel#label_orderError {
    color: #C0392B;
    font: 12px 'Inter';
    font-weight: 600;
}

#SwapWidget QLabel#label_networkNotice,
#SwapWidget QLabel#label_refundHint,
#SwapWidget QLabel#label_memoHint {
    color: #9A5B00;
    font: 12px 'Inter';
    font-weight: 600;
}

#SwapWidget QLabel#label_orderHeadline {
    color: #16191D;
    font: 20px 'Inter';
    font-weight: 700;
}

/* Recoloured by the "state" property rather than by three separate labels, so
   a finished swap reads green and a failed one reads as an error. */
#SwapWidget QLabel#label_orderStatus {
    color: #16191D;
    font: 15px 'Inter';
    font-weight: 600;
}

#SwapWidget QLabel#label_orderStatus[state="pending"] {
    color: #FE681B;
}

#SwapWidget QLabel#label_orderStatus[state="done"] {
    color: #1F9D53;
}

#SwapWidget QLabel#label_orderStatus[state="neutral"],
#SwapWidget QLabel#label_orderOutcome[state="neutral"] {
    color: #5A6472;
}

#SwapWidget QLabel#label_orderStatus[state="failed"] {
    color: #C0392B;
}

/* The closing line of the swap. Carries the same colour as the status above
   it so a finished order and a failed one are told apart at a glance rather
   than by reading. */
#SwapWidget QLabel#label_orderOutcome {
    font: 13px 'Inter';
    font-weight: 600;
}

#SwapWidget QLabel#label_orderOutcome[state="done"] {
    color: #1F9D53;
}

#SwapWidget QLabel#label_orderOutcome[state="failed"] {
    color: #C0392B;
}

#SwapWidget QLabel#label_orderEta {
    color: #8B95A3;
    font: 12px 'Inter';
}

#SwapWidget QLabel#label_depositAmount {
    color: #16191D;
    font: 20px 'Inter';
    font-weight: 700;
}

/* The address is transcribed or compared, never read as prose. */
#SwapWidget QLabel#label_depositAddress,
#SwapWidget QLabel#label_orderId {
    color: #16191D;
    font: 12px 'JetBrains Mono', monospace;
}

/* The code paints its own white plate with this radius; the label behind it
   stays out of the way. */
#SwapWidget QLabel#qrCode {
    background: transparent;
    border-radius: 14px;
}

/* Sync progress, far left of the status bar. Reads as a progress bar because
   it now carries counts beside it, but stays short enough not to compete with
   the balance on the right. */
#statusSyncBar {
    background: #E2E6EB;
    border: none;
    border-radius: 4px;
}

#statusSyncBar::chunk {
    background: #FE681B;
    border-radius: 4px;
}

/* ---------------------- Left navigation rail ---------------------- */

#leftBar {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E6EB;
}

#leftBar QWidget {
	background-color: transparent;
}

/* Scoped to window chrome only: a bare "QLabel" rule here is an ancestor
   stylesheet and would override every page's label colour. */
#page_offline QLabel,
#page_lock QLabel {
	font-family: 'Inter';
	color: #16191D;
}

#leftBar QLabel {
    color: #16191D;
    background-color: transparent;
}

#leftBar #title {
    color: #16191D;
    font: 15px 'Inter';
    font-weight: 700;
}

/* Navigation rows carry no button surface at all: state is expressed by a
   slim accent rail plus icon/label emphasis. */
#leftBar #portfolioWidget,
#leftBar #sendWidget,
#leftBar #receiveWidget,
#leftBar #swapWidget,
#leftBar #historyWidget {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
}

#leftBar #portfolioWidget:hover,
#leftBar #sendWidget:hover,
#leftBar #receiveWidget:hover,
#leftBar #swapWidget:hover,
#leftBar #historyWidget:hover {
    border-left: 3px solid #C6CDD6;
}

#leftBar #portfolioWidget[active="true"],
#leftBar #sendWidget[active="true"],
#leftBar #receiveWidget[active="true"],
#leftBar #swapWidget[active="true"],
#leftBar #historyWidget[active="true"] {
    border-left: 3px solid #FE681B;
}

#leftBar QPushButton {
    background-color: transparent;
    border: none;
	color: #6B7480;
	font: 14px 'Inter';
    text-align: left;
    padding: 0;
}

#leftBar QPushButton:hover {
	color: #16191D;
}

#leftBar QPushButton[active="true"] {
	color: #16191D;
	font-weight: 600;
}

/* ===================== Wizard pages ===================== */
/* Previously inline on PageMenu.ui / WalletWizard.cpp, which made the wizard
   un-themeable: a stylesheet set on a widget outranks the application sheet. */

/* QWizard wraps its pages in unnamed internal widgets (a QWidget and, in
   ModernStyle, a QFrame) that paint their own background. Without these the
   page area keeps the palette default and only the button bar gets themed.
   The dot form matches those plain instances without capturing QWizardPage,
   InfoFrame or the card frames, which carry their own rules. */
QWizard > .QWidget,
QWizard .QFrame {
    background: #FFFFFF;
}

QWizard #PageMenu {
    background: #FFFFFF;
}

QWizard #groupBox {
    /* Padding here is invisible to the layout's size hint, so the card was
       sized as if it had none and its last rows ran past the bottom edge. The
       card's breathing room is layout margins in PageMenu.ui instead. */
    padding: 0;
    border: none;
    border-radius: 12px;
    background-color: #F7F8FA;
}

QWizard #groupBox::title {
    color: #16191D;
    font: 14px 'Inter';
}

/* Divider lines are plain QFrames too, so they need to outrank the page
   background rule above or they vanish into it. */
QWizard .QFrame[frameShape="HLine"],
QWizard .QFrame[frameShape="VLine"],
QWizard #line,
QWizard #line_2 {
    background-color: #E2E6EB;
    color: #E2E6EB;
    border: none;
    max-height: 1px;
}

/* ---- welcome page brand header ---- */

QWizard #brandTitle {
    color: #16191D;
    font: 30px 'Inter';
    font-weight: 700;
    background: transparent;
}

QWizard #brandSubtitle {
    color: #5A6472;
    font: 17px 'Inter';
    background: transparent;
}

QWizard #brandLogo {
    background: transparent;
}

/* Labels the card it now sits inside, so it reads as a caption, not a heading. */
QWizard #selectOption {
    color: #5A6472;
    font: 14px 'Inter';
}

QWizard #label_version {
    color: #8B95A3;
    font: 12px 'Inter';
}

QWizard #restoreWalletTitle {
    color: #5A6472;
}

/* Wizard navigation buttons (Back / Next / Finish / Help / Settings). */
/* Navigation buttons only. This deliberately targets QPushButton rather than
   QAbstractButton: radio buttons and checkboxes derive from QAbstractButton
   too, and picking them up gave them a button face and an accent box on
   hover. */
QWizard QPushButton {
    min-width: 60px;
    min-height: 26px;
}

QWizard QPushButton:pressed {
    background-color: #E8ECF1;
}

/* Choice rows highlight themselves, not a surrounding box. */
QWizard QRadioButton:hover,
QWizard QCheckBox:hover {
    color: #FE681B;
    background: transparent;
    border: none;
}

/* ===================== Tickers ===================== */

#TickersWidget QLabel,
#TickerWidget QLabel {
    color: #16191D;
}

#TickersWidget #line {
    background-color: #E2E6EB;
}

/* Chart timeframe selector: a segmented control, not five buttons. */
#HomeWidget QFrame#rangeSelector,
#HomeWidget QFrame#modeSelector {
    background: #FFFFFF;
    border: 1px solid #E2E6EB;
    border-radius: 10px;
}

/* Tightened from 5px/12px/34px: the row now carries a second segmented control
   beside it, and at the old size the two together crowded the card's title. */
#HomeWidget QFrame#rangeSelector QPushButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    color: #5A6472;
    font: 11px 'Inter';
    font-weight: 600;
    padding: 4px 8px;
    min-width: 26px;
}

#HomeWidget QFrame#rangeSelector QPushButton:hover {
    color: #16191D;
}

/* White, not #16191D: text on the accent fill stays white on both skins, the
   same as btnSend. The dark ink here was a leftover from the mechanical
   recolour and left the selected range near-unreadable on orange. */
#HomeWidget QFrame#rangeSelector QPushButton:checked {
    background: #FE681B;
    color: #FFFFFF;
}

/* What the chart is of, rather than how far back it goes. Deliberately not the
   accent fill the range buttons use -- two filled pills side by side read as
   one control with two active segments. This one lifts its selection instead. */
#HomeWidget QFrame#modeSelector QPushButton {
    background: transparent;
    /* Transparent rather than none: the checked state adds a 1px border, and
       with no border reserved here the button would grow by 2px as you toggle
       it and shove its neighbour sideways. */
    border: 1px solid transparent;
    border-radius: 7px;
    color: #5A6472;
    font: 11px 'Inter';
    font-weight: 600;
    padding: 4px 12px;
    min-width: 58px;
}

#HomeWidget QFrame#modeSelector QPushButton:hover {
    color: #16191D;
}

#HomeWidget QFrame#modeSelector QPushButton:checked {
    background: #FFFFFF;
    border: 1px solid #FE681B;
    color: #16191D;
}

/* Hover readout floating over the plot. */
#HomeWidget QFrame#chartTooltip {
    background: #F7F8FA;
    border: 1px solid #FFFFFF;
    border-radius: 8px;
}

#HomeWidget QLabel#chartTooltipValue {
    color: #16191D;
    font: 13px 'Inter';
    font-weight: 700;
    background: transparent;
}

#HomeWidget QLabel#chartTooltipDate {
    color: #5A6472;
    font: 11px 'Inter';
    background: transparent;
}
